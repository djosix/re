#!/bin/bash
# Claude Code via the credential gateway. Provider: RE_PROVIDER=anthropic|deepseek|openrouter
set -euo pipefail
gw=${RE_GATEWAY:-http://gateway:8080}
unset ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN
export ANTHROPIC_AUTH_TOKEN=sandbox-placeholder-not-a-real-key   # replaced by the gateway
# -m on the host (RE_MODEL[,RE_SMALL_MODEL]) pins every model tier unless set explicitly.
if [ -n "${RE_MODEL:-}" ]; then
  small=${RE_SMALL_MODEL:-$RE_MODEL}
  export ANTHROPIC_MODEL="${ANTHROPIC_MODEL:-$RE_MODEL}"
  export ANTHROPIC_DEFAULT_FABLE_MODEL="${ANTHROPIC_DEFAULT_FABLE_MODEL:-$RE_MODEL}"
  export ANTHROPIC_DEFAULT_OPUS_MODEL="${ANTHROPIC_DEFAULT_OPUS_MODEL:-$RE_MODEL}"
  export ANTHROPIC_DEFAULT_SONNET_MODEL="${ANTHROPIC_DEFAULT_SONNET_MODEL:-$RE_MODEL}"
  export ANTHROPIC_DEFAULT_HAIKU_MODEL="${ANTHROPIC_DEFAULT_HAIKU_MODEL:-$small}"
  export CLAUDE_CODE_SUBAGENT_MODEL="${CLAUDE_CODE_SUBAGENT_MODEL:-$RE_MODEL}"
fi
case "${RE_PROVIDER:-anthropic}" in
  anthropic)  export ANTHROPIC_BASE_URL=$gw/anthropic ;;
  deepseek)   export ANTHROPIC_BASE_URL=$gw/deepseek/anthropic CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
              export ANTHROPIC_MODEL=${ANTHROPIC_MODEL:-deepseek-v4-pro}
              export ANTHROPIC_DEFAULT_OPUS_MODEL=${ANTHROPIC_DEFAULT_OPUS_MODEL:-deepseek-v4-pro}
              export ANTHROPIC_DEFAULT_SONNET_MODEL=${ANTHROPIC_DEFAULT_SONNET_MODEL:-deepseek-v4-pro}
              export ANTHROPIC_DEFAULT_HAIKU_MODEL=${ANTHROPIC_DEFAULT_HAIKU_MODEL:-deepseek-flash} ;;
  openrouter) export ANTHROPIC_BASE_URL=$gw/openrouter CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1 ;;
  *) echo "claude: unsupported RE_PROVIDER=$RE_PROVIDER (anthropic|deepseek|openrouter)" >&2; exit 2 ;;
esac
exec /usr/local/bin/claude "$@"
