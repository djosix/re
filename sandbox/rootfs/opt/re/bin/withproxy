#!/bin/sh
# Run a command with the relay's egress proxy (only RE_EGRESS_DOMAINS are reachable).
export HTTP_PROXY=http://relay:3128 HTTPS_PROXY=http://relay:3128 http_proxy=http://relay:3128 https_proxy=http://relay:3128
export NO_PROXY=gateway,relay,localhost,127.0.0.1 no_proxy=gateway,relay,localhost,127.0.0.1
exec "$@"
