{
  "routes": [
    {
      "name": "anthropic",
      "upstream": "https://api.anthropic.com",
      "credentials": [
        {"secret": "anthropic_api_key", "header": "x-api-key", "format": "{key}"}
      ],
      "allow_paths": ["/v1/messages", "/v1/models"]
    },
    {
      "name": "openai",
      "upstream": "https://api.openai.com",
      "credentials": [
        {"secret": "openai_api_key", "header": "Authorization", "format": "Bearer {key}"}
      ],
      "allow_paths": ["/v1/responses", "/v1/chat/completions", "/v1/models"]
    },
    {
      "name": "deepseek",
      "upstream": "https://api.deepseek.com",
      "credentials": [
        {"secret": "deepseek_api_key", "header": "Authorization", "format": "Bearer {key}"}
      ],
      "allow_paths": ["/chat/completions", "/v1/chat/completions", "/responses", "/v1/responses", "/models", "/v1/models", "/anthropic/v1/messages", "/anthropic/v1/models"]
    },
    {
      "name": "openrouter",
      "upstream": "https://openrouter.ai/api",
      "credentials": [
        {"secret": "openrouter_api_key", "header": "Authorization", "format": "Bearer {key}"}
      ],
      "allow_paths": ["/v1/chat/completions", "/v1/messages", "/v1/responses", "/v1/models"]
    },
    {
      "name": "venice",
      "upstream": "https://api.venice.ai/api",
      "credentials": [
        {"secret": "venice_api_key", "header": "Authorization", "format": "Bearer {key}"}
      ],
      "allow_paths": ["/v1/chat/completions", "/v1/models"]
    }
  ]
}
